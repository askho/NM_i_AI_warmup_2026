index 0000000000000000000000000000000000000000..b76ec6bcc88d485db8926d6965adeb0f2c47a3e1
--- /dev/null
+++ b/policies/optimal_one_bot.py
@@ -0,0 +1,166 @@
+from __future__ import annotations
+
+from collections import Counter
+from typing import Any, Dict, List, Optional, Tuple
+
+from planning.onebot_opt import OneBotPlanner
+
+Pos = Tuple[int, int]
+Action = Dict[str, Any]
+
+
+def _to_pos(p: Any) -> Optional[Pos]:
+    if isinstance(p, dict):
+        if "position" in p:
+            return _to_pos(p.get("position"))
+        if "x" in p and "y" in p:
+            return int(p.get("x", 0) or 0), int(p.get("y", 0) or 0)
+    if isinstance(p, (list, tuple)) and len(p) >= 2:
+        return int(p[0]), int(p[1])
+    return None
+
+
+def _order_sequence(order: Dict[str, Any], fallback_index: int = -1) -> int:
+    raw_id = str(order.get("id", ""))
+    suffix = raw_id.rsplit("_", 1)[-1]
+    try:
+        return int(suffix)
+    except (TypeError, ValueError):
+        return fallback_index
+
+
+def _active_order(orders: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
+    indexed = [(i, o) for i, o in enumerate(orders or []) if isinstance(o, dict) and o.get("status") == "active"]
+    if not indexed:
+        return None
+    non_complete = [(i, o) for i, o in indexed if not bool(o.get("complete", False))]
+    _, best = max(non_complete or indexed, key=lambda io: _order_sequence(io[1], io[0]))
+    return best
+
+
+def _remaining_need(order: Optional[Dict[str, Any]]) -> Counter:
+    if not order:
+        return Counter()
+    req = order.get("items_required", []) or order.get("items", []) or []
+    delivered = order.get("items_delivered", []) or []
+    need = Counter(str(t) for t in req)
+    need.subtract(str(t) for t in delivered)
+    return Counter({k: v for k, v in need.items() if v > 0})
+
+
+def _inventory_types(inv: List[Any]) -> List[str]:
+    out: List[str] = []
+    for item in inv or []:
+        if isinstance(item, str):
+            out.append(item)
+        elif isinstance(item, dict) and item.get("type"):
+            out.append(str(item.get("type")))
+    return out
+
+
+def _move_action(a: Pos, b: Pos) -> str:
+    dx, dy = b[0] - a[0], b[1] - a[1]
+    if dx == 1 and dy == 0:
+        return "move_right"
+    if dx == -1 and dy == 0:
+        return "move_left"
+    if dx == 0 and dy == 1:
+        return "move_down"
+    if dx == 0 and dy == -1:
+        return "move_up"
+    return "wait"
+
+
+class NewOptimalPolicy:
+    def __init__(self) -> None:
+        self._planner: Optional[OneBotPlanner] = None
+        self._queue: List[Dict[str, Any]] = []
+        self._last_order_id: Optional[str] = None
+
+    def _ensure_planner(self, controller) -> None:
+        if self._planner is None:
+            self._planner = OneBotPlanner(controller)
+
+    def _should_replan(self, state: Dict[str, Any], active_order_id: Optional[str]) -> bool:
+        if active_order_id != self._last_order_id:
+            return True
+        if not self._queue:
+            return True
+        planned_ids = [s.get("item_id") for s in self._queue if s.get("kind") == "PICK"]
+        current_item_ids = {str(it.get("id")) for it in state.get("items", []) if isinstance(it, dict)}
+        return any(pid not in current_item_ids for pid in planned_ids if pid)
+
+    def _build_queue(self, state: Dict[str, Any], controller, bot_pos: Pos, need: Counter) -> None:
+        self._ensure_planner(controller)
+        blocked = controller.blocked_positions(state)
+        blocked.discard(bot_pos)
+        self._queue = self._planner.build_plan(
+            state=state,
+            bot_pos=bot_pos,
+            need=need,
+            blocked=blocked,
+            dropoff=controller.dropoff,
+        )
+
+    def __call__(self, state: Dict[str, Any], controller) -> List[Action]:
+        if state.get("type") != "game_state":
+            return []
+        bots = state.get("bots", [])
+        if not isinstance(bots, list) or not bots:
+            return []
+        bot = bots[0]
+        bot_id = bot.get("id")
+        bot_pos = _to_pos(bot.get("position")) or (0, 0)
+        inv = bot.get("inventory", []) or []
+
+        order = _active_order(state.get("orders", []) or [])
+        order_id = str(order.get("id")) if isinstance(order, dict) else None
+        need = _remaining_need(order)
+        inv_types = _inventory_types(inv)
+
+        if bot_pos == controller.dropoff and any(need.get(t, 0) > 0 for t in inv_types):
+            return [{"bot": bot_id, "action": "drop_off"}]
+
+        if self._should_replan(state, order_id):
+            self._build_queue(state, controller, bot_pos, need)
+            self._last_order_id = order_id
+
+        if not self._queue:
+            return [{"bot": bot_id, "action": "wait"}]
+
+        for _ in range(4):
+            if not self._queue:
+                break
+            step = self._queue[0]
+            if step["kind"] == "MOVE_TO":
+                target = step["target"]
+                blocked = controller.blocked_positions(state)
+                blocked.discard(bot_pos)
+                self._ensure_planner(controller)
+                path = self._planner.dist.path(bot_pos, target, blocked=blocked)
+                if len(path) >= 2:
+                    return [{"bot": bot_id, "action": _move_action(path[0], path[1])}]
+                self._queue.pop(0)
+                continue
+
+            if step["kind"] == "PICK":
+                shelf = step["shelf"]
+                if abs(bot_pos[0] - shelf[0]) + abs(bot_pos[1] - shelf[1]) == 1 and len(inv) < 3:
+                    self._queue.pop(0)
+                    return [{"bot": bot_id, "action": "pick_up", "item_id": step["item_id"]}]
+                self._build_queue(state, controller, bot_pos, need)
+                return [{"bot": bot_id, "action": "wait"}]
+
+            if step["kind"] == "DROPOFF":
+                if bot_pos == controller.dropoff:
+                    self._queue.pop(0)
+                    return [{"bot": bot_id, "action": "drop_off"}]
+                self._queue[0] = {"kind": "MOVE_TO", "target": controller.dropoff}
+                continue
+
+            self._queue.pop(0)
+
+        return [{"bot": bot_id, "action": "wait"}]
+
+
+policy = NewOptimalPolicy()
