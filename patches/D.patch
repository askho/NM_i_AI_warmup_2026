@@ -0,0 +1,63 @@
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+from bot_controller import BotController
+from policies.optimal_one_bot import NewOptimalPolicy
+
+
+def test_optimal_policy_picks_adjacent_required_item():
+    policy = NewOptimalPolicy()
+    controller = BotController(policy)
+    state = {
+        "type": "game_state",
+        "round": 1,
+        "board": {"width": 6, "height": 4, "walls": []},
+        "drop_off": [5, 3],
+        "bots": [{"id": 0, "position": {"x": 1, "y": 0}, "inventory": []}],
+        "items": [
+            {"id": "a_far", "type": "A", "position": [4, 0]},
+            {"id": "b_near", "type": "B", "position": [2, 0]},
+        ],
+        "orders": [
+            {
+                "id": "order_1",
+                "status": "active",
+                "items_required": ["A", "B"],
+                "items_delivered": [],
+                "complete": False,
+            }
+        ],
+    }
+
+    action = controller.act(state)[0]
+    assert action["action"] == "pick_up"
+    assert action["item_id"] == "b_near"
+
+
+def test_optimal_policy_drops_at_dropoff_when_matching_inventory():
+    policy = NewOptimalPolicy()
+    controller = BotController(policy)
+    state = {
+        "type": "game_state",
+        "round": 10,
+        "board": {"width": 6, "height": 6, "walls": []},
+        "drop_off": [1, 1],
+        "bots": [{"id": 0, "position": {"x": 1, "y": 1}, "inventory": ["milk"]}],
+        "items": [{"id": "i1", "type": "milk", "position": [2, 1]}],
+        "orders": [
+            {
+                "id": "order_5",
+                "status": "active",
+                "items_required": ["milk"],
+                "items_delivered": [],
+                "complete": False,
+            }
+        ],
+    }
+
+    action = controller.act(state)[0]
+    assert action["action"] == "drop_off"
