@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+from collections import deque
+from typing import Dict, Iterable, Optional, Tuple
+
+from planning.pathfinding import neighbors4
+
+Pos = Tuple[int, int]
+
+
+class DistCache:
+    """On-demand BFS distance/path cache for a static grid."""
+
+    def __init__(self, *, width: int, height: int, walls: set[Pos]) -> None:
+        self.width = width
+        self.height = height
+        self.walls = set(walls)
+        self._dist: Dict[Pos, Dict[Pos, int]] = {}
+        self._parent: Dict[Pos, Dict[Pos, Pos]] = {}
+
+    def _is_free(self, p: Pos) -> bool:
+        x, y = p
+        return 0 <= x < self.width and 0 <= y < self.height and p not in self.walls
+
+    def ensure_from(self, start: Pos, blocked: Optional[set[Pos]] = None) -> None:
+        blocked_cells = set(blocked or set()) - {start}
+        key = start
+        if not blocked_cells and key in self._dist:
+            return
+
+        q = deque([start])
+        dist: Dict[Pos, int] = {start: 0}
+        parent: Dict[Pos, Pos] = {}
+
+        while q:
+            cur = q.popleft()
+            for nxt in neighbors4(cur):
+                if nxt in dist:
+                    continue
+                if nxt in blocked_cells:
+                    continue
+                if not self._is_free(nxt):
+                    continue
+                dist[nxt] = dist[cur] + 1
+                parent[nxt] = cur
+                q.append(nxt)
+
+        if not blocked_cells:
+            self._dist[key] = dist
+            self._parent[key] = parent
+        else:
+            self._dist[(start, tuple(sorted(blocked_cells)))] = dist
+            self._parent[(start, tuple(sorted(blocked_cells)))] = parent
+
+    def dist(self, a: Pos, b: Pos, blocked: Optional[set[Pos]] = None) -> int:
+        blocked_cells = set(blocked or set()) - {a}
+        key = a if not blocked_cells else (a, tuple(sorted(blocked_cells)))
+        if key not in self._dist:
+            self.ensure_from(a, blocked)
+        return self._dist[key].get(b, 10**9)
+
+    def path(self, a: Pos, b: Pos, blocked: Optional[set[Pos]] = None) -> list[Pos]:
+        blocked_cells = set(blocked or set()) - {a}
+        key = a if not blocked_cells else (a, tuple(sorted(blocked_cells)))
+        if key not in self._dist:
+            self.ensure_from(a, blocked)
+        dist = self._dist[key]
+        parent = self._parent[key]
+        if b not in dist:
+            return []
+        out = [b]
+        while out[-1] != a:
+            out.append(parent[out[-1]])
+        out.reverse()
+        return out
