+++ b/planning/onebot_opt.py
@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+import itertools
+from collections import Counter
+from dataclasses import dataclass
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+from planning.distances import DistCache
+from planning.pathfinding import neighbors4
+
+Pos = Tuple[int, int]
+INF = 10**9
+
+
+@dataclass(frozen=True)
+class ItemCand:
+    item_id: str
+    item_type: str
+    shelf_pos: Pos
+    stands: Tuple[Pos, ...]
+
+
+@dataclass
+class TripPlan:
+    item_indices: Tuple[int, ...]
+    stands: Tuple[Pos, ...]
+
+
+class OneBotPlanner:
+    def __init__(self, controller, *, k_per_type: int = 5, max_candidates: int = 18) -> None:
+        self.controller = controller
+        self.k_per_type = k_per_type
+        self.max_candidates = max_candidates
+        self.dist = DistCache(width=controller.width, height=controller.height, walls=set(getattr(controller, "walls", set())))
+
+    @staticmethod
+    def _to_pos(p: Any) -> Optional[Pos]:
+        if isinstance(p, dict):
+            if "position" in p:
+                return OneBotPlanner._to_pos(p.get("position"))
+            if "x" in p and "y" in p:
+                return int(p.get("x", 0) or 0), int(p.get("y", 0) or 0)
+        if isinstance(p, (list, tuple)) and len(p) >= 2:
+            return int(p[0]), int(p[1])
+        return None
+
+    def select_candidates(self, state: Dict[str, Any], need: Counter, bot_pos: Pos, blocked: set[Pos]) -> List[ItemCand]:
+        per_type: Dict[str, List[Tuple[int, ItemCand]]] = {}
+        for item in state.get("items", []):
+            if not isinstance(item, dict):
+                continue
+            t = str(item.get("type"))
+            if need.get(t, 0) <= 0:
+                continue
+            item_id = str(item.get("id", ""))
+            shelf = self._to_pos(item.get("position"))
+            if not item_id or shelf is None:
+                continue
+
+            stands = [p for p in neighbors4(shelf) if self.controller.is_free_static(p) and p not in blocked]
+            if not stands:
+                continue
+
+            d = min(self.dist.dist(bot_pos, s, blocked=blocked) for s in stands)
+            cand = ItemCand(item_id=item_id, item_type=t, shelf_pos=shelf, stands=tuple(stands))
+            per_type.setdefault(t, []).append((d, cand))
+
+        cands: List[ItemCand] = []
+        for entries in per_type.values():
+            entries.sort(key=lambda x: x[0])
+            cands.extend(c for _, c in entries[: self.k_per_type])
+
+        cands.sort(key=lambda c: min(self.dist.dist(bot_pos, s, blocked=blocked) for s in c.stands))
+        return cands[: self.max_candidates]
+
+    def _trip_from_subset(self, *, start: Pos, subset: Sequence[int], cands: Sequence[ItemCand], dropoff: Pos, blocked: set[Pos]) -> Tuple[int, Optional[TripPlan]]:
+        best_cost = INF
+        best_plan: Optional[TripPlan] = None
+        items = [cands[i] for i in subset]
+        for perm_positions in itertools.permutations(range(len(items))):
+            perm_indices = tuple(subset[i] for i in perm_positions)
+            perm_items = [items[i] for i in perm_positions]
+            for stand_choices in itertools.product(*[it.stands for it in perm_items]):
+                cur = start
+                move_cost = 0
+                feasible = True
+                for stand in stand_choices:
+                    d = self.dist.dist(cur, stand, blocked=blocked)
+                    if d >= INF:
+                        feasible = False
+                        break
+                    move_cost += d
+                    cur = stand
+                if not feasible:
+                    continue
+                d_end = self.dist.dist(cur, dropoff, blocked=blocked)
+                if d_end >= INF:
+                    continue
+                total = move_cost + d_end + len(perm_indices) + 1
+                if total < best_cost:
+                    best_cost = total
+                    best_plan = TripPlan(item_indices=perm_indices, stands=tuple(stand_choices))
+        return best_cost, best_plan
+
+    @staticmethod
+    def _meets_need(mask: int, cands: Sequence[ItemCand], need: Counter) -> bool:
+        got = Counter()
+        for i, cand in enumerate(cands):
+            if mask & (1 << i):
+                got[cand.item_type] += 1
+        return all(got[t] >= need[t] for t in need)
+
+    @staticmethod
+    def _subsets_upto3(n: int) -> List[int]:
+        out = []
+        indices = range(n)
+        for r in (1, 2, 3):
+            for comb in itertools.combinations(indices, r):
+                m = 0
+                for i in comb:
+                    m |= 1 << i
+                out.append(m)
+        return out
+
+    def build_plan(self, *, state: Dict[str, Any], bot_pos: Pos, need: Counter, blocked: set[Pos], dropoff: Pos) -> List[Dict[str, Any]]:
+        if not need:
+            return []
+        cands = self.select_candidates(state, need, bot_pos, blocked)
+        if not cands:
+            return []
+
+        n = len(cands)
+        subsets = self._subsets_upto3(n)
+        trip_start: Dict[int, Tuple[int, Optional[TripPlan]]] = {}
+        trip_drop: Dict[int, Tuple[int, Optional[TripPlan]]] = {}
+        for subset_mask in subsets:
+            subset = [i for i in range(n) if subset_mask & (1 << i)]
+            trip_start[subset_mask] = self._trip_from_subset(start=bot_pos, subset=subset, cands=cands, dropoff=dropoff, blocked=blocked)
+            trip_drop[subset_mask] = self._trip_from_subset(start=dropoff, subset=subset, cands=cands, dropoff=dropoff, blocked=blocked)
+
+        dp: Dict[int, int] = {0: 0}
+        prev: Dict[int, Tuple[int, int]] = {}
+        for mask in range(1 << n):
+            if mask not in dp:
+                continue
+            for subset in subsets:
+                if mask & subset:
+                    continue
+                trip_cost, _ = trip_start[subset] if mask == 0 else trip_drop[subset]
+                if trip_cost >= INF:
+                    continue
+                new_mask = mask | subset
+                cand_cost = dp[mask] + trip_cost
+                if new_mask not in dp or cand_cost < dp[new_mask]:
+                    dp[new_mask] = cand_cost
+                    prev[new_mask] = (mask, subset)
+
+        feasible_masks = [m for m in dp if self._meets_need(m, cands, need)]
+        if not feasible_masks:
+            return []
+        best_mask = min(feasible_masks, key=lambda m: dp[m])
+
+        batches: List[int] = []
+        cur = best_mask
+        while cur:
+            pm, sub = prev[cur]
+            batches.append(sub)
+            cur = pm
+        batches.reverse()
+
+        steps: List[Dict[str, Any]] = []
+        for batch in batches:
+            _, trip = trip_start[batch] if not steps else trip_drop[batch]
+            if trip is None:
+                return []
+            for idx, stand in zip(trip.item_indices, trip.stands):
+                steps.append({"kind": "MOVE_TO", "target": stand})
+                steps.append({"kind": "PICK", "item_id": cands[idx].item_id, "shelf": cands[idx].shelf_pos})
+            steps.append({"kind": "MOVE_TO", "target": dropoff})
+            steps.append({"kind": "DROPOFF"})
+        return steps
